# Copiez ce fichier en `.env` (jamais commité) ou saisissez ces variables
# dans Netlify > Site configuration > Environment variables.
# Ces clés ne sont lues QUE par la fonction serverless : elles n'arrivent jamais dans le navigateur.

# Source principale (gratuite, sans carte) — https://www.football-data.org/client/register
FOOTBALL_DATA_TOKEN=

# Optionnel — fiches détaillées (compositions, statistiques, Botola)
# https://dashboard.api-football.com/register — 100 requêtes/jour en gratuit
API_FOOTBALL_KEY=
# Budget journalier maximum que l'application s'autorise (garde une marge sous 100)
API_FOOTBALL_DAILY_BUDGET=90

# TheSportsDB : la clé publique gratuite "123" est utilisée par défaut.
# Ne renseignez une valeur que si vous avez une clé personnelle.
THESPORTSDB_KEY=
